[Unit]
Description=Watchdog Environmental Monitor - BLE Service
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=__WATCHDOG_USER__
Group=__WATCHDOG_GROUP__
WorkingDirectory=__WATCHDOG_DIR__
ExecStart=__WATCHDOG_DIR__/venv/bin/python ble_watchdog.py

Restart=always
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=5

Environment=PYTHONUNBUFFERED=1

MemoryMax=256M
Nice=-5

StandardOutput=journal
StandardError=journal

KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

