[Unit]
Description=Watchdog Environmental Monitor - BLE Service
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=5


[Service]
Type=simple
User=__WATCHDOG_USER__
Group=__WATCHDOG_GROUP__
WorkingDirectory=__WATCHDOG_DIR__
ExecStartPre=/usr/bin/test -x __WATCHDOG_DIR__/venv/bin/python
ExecStartPre=/usr/bin/test -f __WATCHDOG_DIR__/ble_watchdog.py

ExecStart=__WATCHDOG_DIR__/venv/bin/python ble_watchdog.py

Restart=always
RestartSec=10s

Environment=PYTHONUNBUFFERED=1

MemoryMax=256M

# Nice=-5 gives moderate priority boost for reliable sensor polling.
# This ensures BLE scanning isn't starved by other processes on the Pi.
# Safe for Pi Zero 2 W. Adjust to 0 if you run other critical services.
Nice=-5

StandardOutput=journal
StandardError=journal

KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

